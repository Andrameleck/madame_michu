{
  "manifest_version": 3,
  "name": "Madame Michu",
  "version": "0.7.2",
  "description": "Madame Michu trie, resume et retrouve les informations de votre messagerie.",
  "author": "Florian Ricquier",

  "browser_specific_settings": {
    "gecko": {
      "id": "assistant-mail-ia@local.thunderbird",
      "strict_min_version": "128.0"
    }
  },

  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  },

  "permissions": [
    "messagesRead",
    "accountsRead",
    "storage",
    "tabs",
    "alarms",
    "notifications"
  ],

  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],

  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "optional_permissions": [
    "sensitiveDataUpload"
  ],

  "background": {
    "scripts": [
      "utils/logger.js",
      "utils/storage.js",
      "utils/htmlToText.js",
      "llm/httpClient.js",
      "llm/promptBuilder.js",
      "llm/responseParser.js",
      "llm/ollamaClient.js",
      "llm/embeddingClient.js",
      "llm/openAiCompatibleClient.js",
      "llm/anthropicClient.js",
      "llm/openAiCodexClient.js",
      "llm/providerClient.js",
      "llm/vectorStore.js",
      "calendar/calendarService.js",
      "background/mailFetcher.js",
      "background/mailIndexer.js",
      "background/chatService.js",
      "background/scheduler.js",
      "background/background.js"
    ]
  },

  "action": {
    "default_icon": "icons/icon-48.svg",
    "default_title": "Demander a Madame Michu"
  },

  "options_ui": {
    "page": "ui/options/options.html",
    "open_in_tab": true
  },

  "experiment_apis": {
    "assistantCalendar": {
      "schema": "experiments/assistantCalendar/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "experiments/assistantCalendar/api.js",
        "paths": [["assistantCalendar"]]
      }
    }
  }
}
